<?xml version="1.0" encoding="utf-8"?>
<!-- 通用「单输入框」对话框内容：端口、连接数、回收阈值、账户名、密码、新建文件夹共用这一份。
     2026-09-30 改动（重要）：把裸 EditText 包进 Material 的 TextInputLayout，
     调用方设置的提示文字会变成「浮动标签」—— 没输入时占位在框内，一开始输入就上浮到框线上方，
     不再像以前那样一输入提示就消失。
     样式用 OutlinedBox（描边框）而不是默认的 FilledBox（带底色的框），
     是为了让边缘更清楚、和原来「无框输入框」的观感差距更小。
     注意：TextInputLayout 只在绑定子输入框的那一刻读取一次提示文字，
     所以调用方不能再对 EditText 设置提示，必须改为对 TextInputLayout 设置
     （见各 Activity 里 dialog_edittext_layout.setHint(...) 的对应改动）。 -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/dialog_edittext_layout"
            style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="20dp">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/dialog_edittext"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:singleLine="true" />
        </com.google.android.material.textfield.TextInputLayout>
    </LinearLayout>
</ScrollView>
