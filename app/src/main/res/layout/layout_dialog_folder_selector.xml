<?xml version="1.0" encoding="utf-8"?>
<!--
  访问路径选择页。

  结构是「顶部一条 header + 中间整块列表 + 底部操作栏」三层的整体，中间只用一条分隔线
  分开，不再把每个区域各自包成圆角卡片 —— 那样一屏会被切成好几块，反而更碎。

  header 里两样东西都可以直接操作：存储分段切换根目录，面包屑的每一级点击直达。
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/color_page_background"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_card_background"
        android:orientation="vertical"
        android:paddingLeft="12dp"
        android:paddingRight="12dp"
        android:paddingBottom="12dp">

        <!-- 存储切换：条目由代码按 StorageUtil.getAvailableStoragePaths() 动态生成，
             只有一个存储时它自然只显示一项。 -->
        <LinearLayout
            android:id="@+id/folder_segment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:orientation="horizontal" />

        <!-- 面包屑：横向可滚动，长路径不会把屏幕撑破。 -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:scrollbars="none">

            <LinearLayout
                android:id="@+id/folder_crumbs"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal" />
        </HorizontalScrollView>
    </LinearLayout>

    <!-- 三种内容态互斥：列表 / 骨架屏 / 空或不可读提示。
         骨架屏的意义是让加载期间高度稳定，不再像旧的 ProgressBar 那样先塌后撑。 -->
    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <ListView
            android:id="@+id/folder_list"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_card_background"
            android:divider="@null"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/folder_skeleton"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_card_background"
            android:orientation="vertical"
            android:paddingLeft="14dp"
            android:paddingRight="14dp"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="0.58"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="0.66"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="0.40"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="0.58"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <View
                    android:layout_width="34dp"
                    android:layout_height="34dp"
                    android:background="@drawable/bg_skeleton" />

                <View
                    android:layout_width="0dp"
                    android:layout_height="12dp"
                    android:layout_marginLeft="10dp"
                    android:layout_weight="0.66"
                    android:background="@drawable/bg_skeleton" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/folder_empty"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@color/color_card_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:paddingLeft="32dp"
            android:paddingRight="32dp"
            android:visibility="gone">

            <ImageView
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:layout_marginTop="96dp"
                android:contentDescription="@string/folder_empty_title"
                android:src="@drawable/icon_folder" />

            <TextView
                android:id="@+id/folder_empty_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:text="@string/folder_empty_title"
                android:textColor="@color/color_text_dark"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/folder_empty_hint"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="center"
                android:text="@string/folder_empty_hint"
                android:textColor="@color/color_text_secondary"
                android:textSize="12.5sp" />
        </LinearLayout>
    </FrameLayout>

    <!-- 底部操作栏：把原来 ActionBar 上的「取消 / 新建 / 确定」三个图标搬下来。
         图标没有文案，语义全靠猜，而且顶栏是单手最难够到的位置。 -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/color_card_background"
        android:orientation="horizontal"
        android:paddingLeft="12dp"
        android:paddingTop="10dp"
        android:paddingRight="12dp"
        android:paddingBottom="10dp">

        <LinearLayout
            android:id="@+id/folder_action_new"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_weight="0.34"
            android:background="@drawable/bg_button_outline"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/word_new_folder"
                android:textColor="@color/color_text_dark"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/folder_action_select"
            android:layout_width="0dp"
            android:layout_height="42dp"
            android:layout_marginLeft="10dp"
            android:layout_weight="0.66"
            android:background="@drawable/bg_folder_btn_solid"
            android:gravity="center"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/folder_action_select_text"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:ellipsize="end"
                android:maxLines="1"
                android:text="@string/folder_select_here"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
