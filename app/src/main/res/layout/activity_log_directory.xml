<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="8dp"
    android:background="@color/color_page_background">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:background="@drawable/bg_card"
        android:orientation="vertical">

        <com.github.stjiege.ftpshare.ui.SubtitleTextView
            android:id="@+id/log_directory_path"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:textColor="@color/color_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <com.github.stjiege.ftpshare.ui.SubtitleTextView
        android:id="@+id/log_directory_empty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:gravity="center"
        android:text="@string/log_directory_empty"
        android:textColor="@color/color_text_secondary"
        android:visibility="gone" />

    <ListView
        android:id="@+id/log_directory_list"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="8dp"
        android:layout_weight="1"
        android:background="@drawable/bg_card"
        android:divider="@color/color_card_divider"
        android:dividerHeight="2px"
        android:padding="4dp" />
</LinearLayout>
