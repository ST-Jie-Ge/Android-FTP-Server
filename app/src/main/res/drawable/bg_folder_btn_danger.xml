<?xml version="1.0" encoding="utf-8"?>
<!-- 破坏性操作的描边按钮：红底红边，但弱于实心主按钮，避免它抢走注意力。 -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="#1F842029">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_banner_error_bg" />
            <stroke
                android:width="1dp"
                android:color="@color/color_danger_button_outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
