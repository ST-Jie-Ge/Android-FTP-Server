<?xml version="1.0" encoding="utf-8"?>
<!-- Outlined action button: a visible edge so the log actions read as buttons, not as text links. -->
<ripple xmlns:android="http://schemas.android.com/apk/res/android"
    android:color="@color/color_button_ripple">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="@color/color_card_background" />
            <stroke
                android:width="1dp"
                android:color="@color/color_button_outline" />
            <corners android:radius="10dp" />
        </shape>
    </item>
</ripple>
