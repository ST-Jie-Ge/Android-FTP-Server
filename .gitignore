# Built application files
*.ap_
*.aab

# Files for the ART/Dalvik VM
*.dex

# Java class files
*.class

# Generated files
bin/
gen/
out/

# Gradle files
.gradle/
build/

# Local configuration file (sdk path, etc)
local.properties

# Proguard folder generated by Eclipse
proguard/

# Log Files
*.log

# Local backups of jars kept next to the real dependency (fork surgery residue)
*.jar.bak

# Android Studio Navigation editor temp files
.navigation/

# Android Studio captures folder
captures/

# IntelliJ
*.iml
.idea/

# Keystore files
# Signing keys and passwords must never enter version control: anyone with them can publish
# updates under this app's identity. Keep local copies outside the repository.
*.jks
*.keystore
keystore.properties

# Build outputs
*.apk
*.aab
signedAPKs/

# WorkBuddy working data (contains local backups; keep it out of history)
.workbuddy/

# Local backups and fork-surgery residue (kept next to real files, never version)
.backup/
*.bak*
outputs/

# Font-task temp artifact
docs/_sanji_raw.txt

# Stray root file (code references org.apache.ftpserver.impl.FtpIoSession instead)
/FtpIoSession.java


# External native build folder generated in Android Studio 2.2 and later
.externalNativeBuild
.cxx/

# Google Services (e.g. APIs or Firebase)
google-services.json

# Freeline
freeline.py
freeline/
freeline_project_description.json

# fastlane
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots
fastlane/test_output
fastlane/readme.md

# Test certificate / key stores (never commit; keep local only)
*.p12
*.pfx
